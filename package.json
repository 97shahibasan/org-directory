{
  "name": "org-directory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "api": "node server/organisations-api.mjs",
    "generate:data": "node scripts/generate-organisations-json.mjs",
    "start": "concurrently -k \"npm run api\" \"ng serve --proxy-config proxy.conf.json\"",
    "start:app": "ng serve --proxy-config proxy.conf.json",


